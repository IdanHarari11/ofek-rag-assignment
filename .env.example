# Server-side only — never use NEXT_PUBLIC_ for API keys.
# Copy to .env (and optionally .env.local). CLI scripts load these via dotenv.

OPENAI_API_KEY=

# Optional overrides (defaults shown)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Chat model for grounded answers. Default: gpt-4.1-mini
GENERATION_MODEL=gpt-4.1-mini

# Stage 5 semantic draft review (claim support / completeness). Default: off.
# Enable with 1|true|on for experiments. Paired eval showed material false blocks
# when left on by default (see eval_results/ask-eval-stage5-paired.*).
ANSWER_REVIEW_ENABLED=0

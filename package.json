{
  "name": "ofek-rag",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "chunk": "tsx scripts/chunk.ts",
    "index": "tsx scripts/index.ts",
    "prepare:rag": "pnpm ingest && pnpm chunk && pnpm index",
    "retrieve": "tsx scripts/retrieve.ts",
    "ask": "tsx scripts/ask.ts",
    "trace": "tsx scripts/trace.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "eval:hybrid": "tsx scripts/eval-hybrid.ts",
    "eval:ask": "tsx scripts/eval-ask.ts",
    "eval:conversation": "tsx scripts/eval-conversation.ts",
    "eval:ask-stage2": "tsx scripts/eval-ask-stage2-regression.ts",
    "eval:ask-stage4": "tsx scripts/eval-ask-stage4.ts",
    "eval:ask-stage5": "tsx scripts/eval-ask-stage5.ts",
    "eval:ask-stage5-paired": "tsx scripts/eval-ask-stage5-paired.ts",
    "eval:conversation-stage5": "tsx scripts/eval-conversation-stage5.ts",
    "eval:ask-stage6-extended": "tsx scripts/eval-ask-stage6-extended.ts",
    "eval:conversation-stage6": "tsx scripts/eval-conversation-stage6.ts",
    "test:ingestion": "vitest run src/ingestion",
    "test:chunking": "vitest run src/chunking",
    "test:rag": "vitest run src/rag src/eval",
    "test:api": "vitest run src/lib/ask-display.test.ts src/lib/rag-chat-model-adapter.test.ts src/lib/chat-history.test.ts src/lib/thread-title.test.ts src/lib/ofek-thread-list-adapter.test.ts src/lib/ofek-thread-list-adapter.race.test.ts src/app/api/ask/route.test.ts",
    "test:rag-prep": "vitest run src/ingestion src/chunking src/rag src/eval",
    "test:gates": "pnpm typecheck && pnpm lint && pnpm test:rag-prep && pnpm test:api && pnpm build"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.30",
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@base-ui/react": "^1.9.0",
    "assistant-stream": "^0.3.53",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.2",
    "node-html-parser": "^9.0.5",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.22.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "unified": "^11.0.5",
    "unpdf": "^1.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
